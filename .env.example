NODE_ENV=development
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Si KEYS est vide dans le container mais que Nest loggue un Redis Darwin :
# un Redis local occupe 6379. Vérifier avec : redis-cli KEYS "*"
DB_HOST=localhost
DB_PORT=5432
DB_USER=winigajordan
DB_PASS=
DB_NAME=whatsapp_bot

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

ANTHROPIC_API_KEY=
# Nombre max de tours tools Claude par réponse (défaut 8)
CLAUDE_TOOL_MAX_ITERATIONS=8
# Prompt caching Anthropic (system + tools). Mettre false pour désactiver.
ANTHROPIC_PROMPT_CACHE_ENABLED=true
# Provider IA conversation : claude | openai
AI_PROVIDER=claude

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Délai debounce avant traitement Claude (ms) — regroupe les rafales WhatsApp
CONVERSATION_DEBOUNCE_DELAY_MS=2500

# Navigation menu par catégories si la carte dépasse ces seuils
MENU_CATEGORY_NAV_MIN_ITEMS=10
MENU_CATEGORY_NAV_MIN_CATEGORIES=3

# Dashboard JWT (Angular)
JWT_SECRET=dev-jwt-secret-change-me-in-prod
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200

# Chiffrement au repos (conversations / messages) — 32 bytes base64
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGE_ENCRYPTION_KEY=
